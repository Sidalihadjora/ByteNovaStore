{
  "name": "modern-algerian-ecommerce-webstore",
  "version": "1.0.0",
  "description": "Modern bilingual Algerian e-commerce web store with data-driven Wilaya and Commune selection, Cash on Delivery, and configurable store settings.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test:db": "node server/test_suite.js",
    "test:http": "node server/test_http.js",
    "test": "node server/test_suite.js && node server/test_http.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "keywords": [
    "ecommerce",
    "algeria",
    "algerie",
    "wilaya-commune-data",
    "cash-on-delivery",
    "react",
    "express",
    "sqlite",
    "tailwind"
  ],
  "author": "SoukDz Team",
  "license": "MIT",
  "engines": {
  "node": ">=22.12.0"
}
}
